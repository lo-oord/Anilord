<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:endColor="@color/anilord_surface_container"
                android:startColor="@color/anilord_surface_container_low" />
            <stroke android:width="1dp" android:color="@color/anilord_outline_subtle" />
        </shape>
    </item>
</layer-list>
